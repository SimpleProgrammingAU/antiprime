{
  "name": "antiprime",
  "version": "2.0.1",
  "description": "Because sometimes we need highly composite numbers",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.config.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "docs:build": "typedoc",
    "prepublishOnly": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "prepare": "lefthook install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimpleProgrammingAU/antiprime.git"
  },
  "keywords": [
    "math",
    "composite",
    "prime",
    "numbers",
    "antiprime",
    "numberphile"
  ],
  "author": "Simple Programming",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SimpleProgrammingAU/antiprime/issues"
  },
  "homepage": "https://github.com/SimpleProgrammingAU/antiprime#readme",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
